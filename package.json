{
  "name": "rvz-reader",
  "version": "1.0.0",
  "description": "Convert Dolphin RVZ/WIA disc images to raw ISO/GCM images",
  "main": "src/index.js",
  "bin": {
    "rvz2iso": "src/cli.js"
  },
  "scripts": {
    "test": "node tests/convert.test.js",
    "test:quick": "node tests/convert.quick.test.js",
    "test:binary": "node tests/convert.binary.test.js",
    "test:binary:quick": "node tests/convert.binary.quick.test.js",
    "build": "node scripts/build.js"
  },
  "license": "MIT",
  "dependencies": {
    "@mongodb-js/zstd": "^7.0.0",
    "lzma-native": "^8.0.6",
    "seek-bzip": "^2.0.0"
  },
  "allowScripts": {
    "@mongodb-js/zstd@7.0.0": true,
    "lzma-native@8.0.6": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.6.0"
  },
  "pkg": {
    "assets": [
      "node_modules/@mongodb-js/zstd/build/Release/*.node",
      "node_modules/lzma-native/prebuilds/**/*"
    ]
  }
}
